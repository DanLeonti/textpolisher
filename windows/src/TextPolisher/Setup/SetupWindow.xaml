<Window x:Class="TextPolisher.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextPolisher Setup"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="White">
    <StackPanel Margin="26">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="/Assets/app.png" Width="34" Height="34" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Setting up TextPolisher" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Preparing the local AI model. This runs once."
                           Foreground="#FF888888" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText" Text="Starting..." FontSize="13"
                   Foreground="#FF333333" Margin="0,0,0,8" TextWrapping="Wrap" />
        <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100"
                     IsIndeterminate="True" Foreground="#FF5B54E8" />
        <TextBlock x:Name="DetailText" Text="" FontSize="11" Foreground="#FFAAAAAA" Margin="0,8,0,0" />
    </StackPanel>
</Window>
