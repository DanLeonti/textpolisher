<Window x:Class="TextPolisher.Preferences.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextPolisher Shortcuts"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="White">
    <StackPanel Margin="22">
        <TextBlock Text="Global Shortcuts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="Click a field and press the key combination you want. Must include Ctrl, Alt, or Win."
                   TextWrapping="Wrap" Foreground="#FF777777" FontSize="12" Margin="0,0,0,18" />

        <TextBlock Text="Polish &amp; preview (overlay)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
        <Button x:Name="SelectionButton" Height="36" Click="OnRecordSelection"
                Content="Ctrl+Alt+P" FontSize="13" Cursor="Hand" Margin="0,0,0,16" />

        <TextBlock Text="Polish &amp; replace now (instant)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
        <Button x:Name="InstantButton" Height="36" Click="OnRecordInstant"
                Content="Ctrl+Alt+Shift+P" FontSize="13" Cursor="Hand" Margin="0,0,0,20" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Restore Defaults" Padding="12,6" Margin="0,0,8,0" Click="OnRestoreDefaults" />
            <Button Content="Save" Padding="18,6" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
