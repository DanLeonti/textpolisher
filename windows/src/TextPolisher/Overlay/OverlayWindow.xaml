<Window x:Class="TextPolisher.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextPolisher"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ToneButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#FFF0F0F3" />
            <Setter Property="Foreground" Value="#FF333333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE3E3EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="#FFF0F0F3" />
            <Setter Property="Foreground" Value="#FF222222" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE3E3EA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FooterButton}">
            <Setter Property="Background" Value="#FF5B54E8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF6E67F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="White" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.28" Color="#FF000000" />
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/app.png" Width="20" Height="20" Margin="0,0,8,0" />
                    <TextBlock Text="Polish Text" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="#FF1A1A1A" />
                </StackPanel>
                <TextBlock Text="{Binding EngineName}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="11" Foreground="#FF999999" />
            </Grid>

            <!-- Tone picker -->
            <StackPanel x:Name="TonePanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" />

            <!-- Original -->
            <TextBlock Grid.Row="2" Text="ORIGINAL" FontSize="10" FontWeight="SemiBold"
                       Foreground="#FFAAAAAA" Margin="2,0,0,4" />
            <Border Grid.Row="3" CornerRadius="8" Background="#FFF6F6F8" Padding="10" Margin="0,0,0,12">
                <TextBox Text="{Binding OriginalText, Mode=OneWay}" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                         FontSize="13" Foreground="#FF555555" MaxHeight="80"
                         VerticalScrollBarVisibility="Auto" IsTabStop="False" />
            </Border>

            <!-- Polished -->
            <Grid Grid.Row="4" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="POLISHED" FontSize="10" FontWeight="SemiBold"
                           Foreground="#FFAAAAAA" Margin="2,0,0,4" />
                <Border Grid.Row="1" CornerRadius="8" Background="#FFF1F0FE" Padding="10">
                    <TextBox Text="{Binding PolishedText, Mode=OneWay}" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                             FontSize="14" Foreground="#FF1A1A1A" MinHeight="60" MaxHeight="240"
                             VerticalScrollBarVisibility="Auto" IsTabStop="False" />
                </Border>
                <ProgressBar Grid.Row="2" Height="3" Margin="0,6,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"
                             Background="Transparent" BorderThickness="0" Foreground="#FF5B54E8" />
            </Grid>

            <!-- Error -->
            <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="#FFCC3333"
                       TextWrapping="Wrap" FontSize="12" Margin="2,0,0,10"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <!-- Footer -->
            <Grid Grid.Row="6">
                <Button Content="Cancel" Style="{StaticResource FooterButton}"
                        HorizontalAlignment="Left" IsCancel="True" Click="OnCancel" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Regenerate" Style="{StaticResource FooterButton}" Click="OnRegenerate" />
                    <Button x:Name="ReplaceButton" Content="Replace" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="OnReplace"
                            IsEnabled="{Binding CanAccept}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
